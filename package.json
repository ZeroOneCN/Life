{
  "name": "lifeos2",
  "private": true,
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0"
  },
  "lint-staged": {
    "client/src/**/*.{ts,tsx}": [
      "npx --prefix client eslint --fix --config client/.eslintrc.cjs",
      "npx --prefix client prettier --write"
    ],
    "client/src/**/*.{json,css,md}": [
      "npx --prefix client prettier --write"
    ]
  }
}